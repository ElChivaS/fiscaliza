rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: obtener org del usuario autenticado ──────────────────────────
    function userOrgId() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.organization_id;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── plan_limits: lectura pública para autenticados ───────────────────────
    match /plan_limits/{plan} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo via Admin SDK
    }

    // ── profiles ─────────────────────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.organization_id == userOrgId()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Solo full_name/avatar_url son editables por el propio usuario — organization_id
      // y role NO, porque userOrgId() lee ese mismo campo y gatea todas las demás reglas.
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'avatar_url']);
      allow delete: if false;
    }

    // ── organizations ────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && orgId == userOrgId();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && orgId == userOrgId();
      allow delete: if false;
    }

    // ── vehicles ─────────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && resource.data.organization_id == userOrgId();
      allow create: if isAuthenticated() && request.resource.data.organization_id == userOrgId();
      allow update: if isAuthenticated() && resource.data.organization_id == userOrgId();
      allow delete: if false; // Soft delete via is_active
    }

    // ── documents ────────────────────────────────────────────────────────────
    match /documents/{documentId} {
      allow read: if isAuthenticated() && resource.data.organization_id == userOrgId();
      allow create: if isAuthenticated() && request.resource.data.organization_id == userOrgId();
      allow update: if isAuthenticated() && resource.data.organization_id == userOrgId();
      allow delete: if false; // Soft delete via is_current
    }

    // ── activity_log ─────────────────────────────────────────────────────────
    match /activity_log/{logId} {
      allow read: if isAuthenticated() && resource.data.organization_id == userOrgId();
      allow create: if isAuthenticated()
        && request.resource.data.organization_id == userOrgId()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if false; // Log inmutable
      allow delete: if false;
    }

    // ── qr_shares: única colección de lectura pública (landing sin sesión) ───
    match /qr_shares/{shareId} {
      allow read: if resource.data.expires_at > request.time;
      allow create: if isAuthenticated() && request.resource.data.organization_id == userOrgId();
      allow update: if false; // Inmutable
      allow delete: if false;
    }

    // ── testers: leads del modal de bienvenida, se escriben SIN sesión ───────
    // (el modal aparece antes de que exista cuenta). Validación mínima para
    // evitar basura/abuso; nadie puede leer/editar desde el cliente.
    match /testers/{leadId} {
      allow create: if request.resource.data.full_name is string
        && request.resource.data.full_name.size() > 0
        && request.resource.data.full_name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() < 200
        && request.resource.data.vehicle_note is string
        && request.resource.data.vehicle_note.size() < 300;
      allow read, update, delete: if false;
    }
  }
}
