rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Firestore Rules puede leer Firestore para validar membresía de organización —
    // mismo criterio que ya usa firestore.rules (userOrgId()).
    function userOrgId() {
      return firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.organization_id;
    }

    match /documents/{orgId}/{vehicleId}/{docType}/{fileName} {
      allow read:   if request.auth != null && orgId == userOrgId();
      allow write:  if request.auth != null && orgId == userOrgId()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if request.auth != null && orgId == userOrgId();
    }

    // Avatares de perfil — solo el propio usuario puede escribir/eliminar
    match /avatars/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && fileName.matches(request.auth.uid + '.*');
      allow delete: if request.auth != null
                    && fileName.matches(request.auth.uid + '.*');
    }
  }
}
