rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Solo el usuario autenticado puede acceder a documentos de su organización
    match /documents/{orgId}/{vehicleId}/{docType}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
